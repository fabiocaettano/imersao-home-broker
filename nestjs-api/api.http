 
# @name createAsset
POST {{host}}/assets
Content-Type: application/json

{
    "name": "Amazon3",
    "symbol": "A3",
    "price": 100,
    "image": "AMZN.png"
}
###

@assetId = {{ createAsset.response.body._id }}
###

GET {{host}}/assets
###

GET {{host}}/assets/A3
###

